<mxfile host="app.diagrams.net" agent="GPIO Genesis" version="24.0.0"><diagram id="arq" name="Arquitectura GPIO Génesis"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L1" value="CAPA FÍSICA — Fase 2 (después de la first-iteration)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#6b7280;dashed=1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1320" height="140" as="geometry"/></mxCell><mxCell id="L2" value="CAPA CLIENTE — PC del jugador (Windows) · aquí corre la parte EDGE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#2563eb;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="20" y="190" width="1320" height="320" as="geometry"/></mxCell><mxCell id="L3" value="CAPA DE DATOS — Cloud" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#effaf1;strokeColor=#15803d;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=828;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#15803d;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="1320" height="180" as="geometry"/></mxCell><mxCell id="L4" value="CAPA DE PRESENTACIÓN Y DISTRIBUCIÓN — Web" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=298;spacingTop=4;fontStyle=1;fontSize=14;fontColor=#c2410c;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="1320" height="170" as="geometry"/></mxCell><mxCell id="note1" value="No entra en la first-iteration (semana 13).&lt;br&gt;Qué hay que considerar: sección 6 de la página." style="text;html=1;align=left;fontSize=12;fontColor=#6b7280;" vertex="1" parent="1"><mxGeometry x="50" y="65" width="420" height="40" as="geometry"/></mxCell><mxCell id="st_hw" value="&lt;b&gt;Sensores y actuadores&lt;/b&gt;&lt;br&gt;N20 + encoder · servo SG90&lt;br&gt;MPU-6050 · INA219 · OLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;strokeWidth=1.6;fontSize=11;dashed=1;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="850" y="55" width="200" height="95" as="geometry"/></mxCell><mxCell id="st_mcu" value="&lt;b&gt;ESP32-S3 (estación)&lt;/b&gt;&lt;br&gt;corre el mismo C++ del&lt;br&gt;jugador (core Arduino-ESP32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;strokeWidth=1.6;fontSize=11;dashed=1;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="1120" y="55" width="200" height="95" as="geometry"/></mxCell><mxCell id="editor" value="&lt;b&gt;Editor C++ (vista 2)&lt;/b&gt;&lt;br&gt;CodeEdit de Godot: resaltado,&lt;br&gt;líneas y consola serial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="235" width="200" height="95" as="geometry"/></mxCell><mxCell id="compiler" value="&lt;b&gt;Compilador local&lt;/b&gt;&lt;br&gt;clang (wasi-sdk) → .wasm&lt;br&gt;incluido en el instalador" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="235" width="200" height="95" as="geometry"/></mxCell><mxCell id="mcu" value="&lt;b&gt;MCU virtual&lt;/b&gt;&lt;br&gt;runtime WAMR + HAL «gpio.h»&lt;br&gt;(API igual a Arduino-ESP32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="235" width="200" height="95" as="geometry"/></mxCell><mxCell id="sim" value="&lt;b&gt;Simulador de la fábrica&lt;/b&gt;&lt;br&gt;Godot 4 · física simplificada&lt;br&gt;vista 1: línea de drones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="235" width="200" height="95" as="geometry"/></mxCell><mxCell id="usb" value="&lt;b&gt;Puente USB (fase 2)&lt;/b&gt;&lt;br&gt;esptool como proceso aparte&lt;br&gt;+ lector de telemetría" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;strokeWidth=1.6;fontSize=11;dashed=1;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="1120" y="235" width="200" height="95" as="geometry"/></mxCell><mxCell id="save" value="&lt;b&gt;Guardado local&lt;/b&gt;&lt;br&gt;progreso y soluciones&lt;br&gt;(funciona sin internet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="395" width="200" height="95" as="geometry"/></mxCell><mxCell id="panel" value="&lt;b&gt;Panel copiloto (vista 3)&lt;/b&gt;&lt;br&gt;explicación + línea marcada&lt;br&gt;+ botón «otra pista»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="310" y="395" width="200" height="95" as="geometry"/></mxCell><mxCell id="diag" value="&lt;b&gt;Diagnóstico local [IA EDGE]&lt;/b&gt;&lt;br&gt;~25 reglas: errores de clang&lt;br&gt;y traza · responde ≤200 ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde68a;strokeColor=#b45309;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="395" width="200" height="95" as="geometry"/></mxCell><mxCell id="valid" value="&lt;b&gt;Validador del nivel&lt;/b&gt;&lt;br&gt;compara la traza contra&lt;br&gt;el objetivo del nivel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#334155;strokeWidth=1.6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="395" width="200" height="95" as="geometry"/></mxCell><mxCell i