 height="22.5" as="geometry"/></mxCell><mxCell id="c476" value="pinMode(LUZ_ESTACION, OUTPUT) — el error típico del nivel." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="201.5" width="539.4" height="22.5" as="geometry"/></mxCell><mxCell id="c477" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6336C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2200" y="222" width="24" height="24" as="geometry"/></mxCell><mxCell id="c478" value="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=13;fontColor=#FFF;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2202.0" y="224.7" width="20.0" height="19.5" as="geometry"/></mxCell><mxCell id="c479" value="Desviación (de C2, cabina oscura): solo la máquina que no hace lo" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="223.5" width="604.5" height="22.5" as="geometry"/></mxCell><mxCell id="c480" value="que pide el nivel se marca: contorno naranja punteado + triángulo +" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="247.5" width="623.1" height="22.5" as="geometry"/></mxCell><mxCell id="c481" value="texto &amp;#x27;debería estar encendida&amp;#x27;. Las que van bien no se marcan." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="269.5" width="585.9" height="22.5" as="geometry"/></mxCell><mxCell id="c482" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6336C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2200" y="290" width="24" height="24" as="geometry"/></mxCell><mxCell id="c483" value="2" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=13;fontColor=#FFF;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2202.0" y="292.7" width="20.0" height="19.5" as="geometry"/></mxCell><mxCell id="c484" value="La traza de D2 se queda en LOW (naranja): se ve que el pin nunca subió." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="291.5" width="660.3" height="22.5" as="geometry"/></mxCell><mxCell id="c485" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6336C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2200" y="314" width="24" height="24" as="geometry"/></mxCell><mxCell id="c486" value="3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=13;fontColor=#FFF;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2202.0" y="316.7" width="20.0" height="19.5" as="geometry"/></mxCell><mxCell id="c487" value="Disparador: el validador marca &amp;#x27;sin progreso&amp;#x27; si un objetivo no se" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="315.5" width="613.8" height="22.5" as="geometry"/></mxCell><mxCell id="c488" value="cumple en 10 s simulados (o hay error de compilación o watchdog)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="339.5" width="604.5" height="22.5" as="geometry"/></mxCell><mxCell id="c489" value="Entonces aparece el marcador y el copiloto ofrece ayuda, sin pausar." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="361.5" width="632.4" height="22.5" as="geometry"/></mxCell><mxCell id="c490" value="Nivel 1 de 4: pregunta, no da la respuesta. Niveles 1 pregunta y" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="383.5" width="595.2" height="22.5" as="geometry"/></mxCell><mxCell id="c491" value="2 señala la máquina = LOCALES (JSON del nivel, sin internet, sin cuota)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="405.5" width="669.6" height="22.5" as="geometry"/></mxCell><mxCell id="c492" value="3 causa física y 4 marca la línea = NUBE (cuenta para la cuota de 10/h)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="427.5" width="669.6" height="22.5" as="geometry"/></mxCell><mxCell id="c493" value="Nunca escribe la solución (RF-04)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="449.5" width="316.2" height="22.5" as="geometry"/></mxCell><mxCell id="c494" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6336C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2200" y="470" width="24" height="24" as="geometry"/></mxCell><mxCell id="c495" value="4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=13;fontColor=#FFF;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2202.0" y="472.7" width="20.0" height="19.5" as="geometry"/></mxCell><mxCell id="c496" value="El editor no se marca todavía: la línea se resalta hasta el nivel 4." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="471.5" width="632.4" height="22.5" as="geometry"/></mxCell><mxCell id="c497" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6336C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2200" y="494" width="24" height="24" as="geometry"/></mxCell><mxCell id="c498" value="5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=13;fontColor=#FFF;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2202.0" y="496.7" width="20.0" height="19.5" as="geometry"/></mxCell><mxCell id="c499" value="El objetivo &amp;#x27;Luz de estación&amp;#x27; sigue sin palomita." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="495.5" width="455.7" height="22.5" as="geometry"/></mxCell><mxCell id="c500" value="Variante crítica (watchdog / error de compilación)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=17;fontColor=#D6336C;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="525.3" width="527.0" height="25.5" as="geometry"/></mxCell><mxCell id="c501" value="Banner rojo #F85149 con octágono sobre la fábrica (1152×72, arriba):" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="553.5" width="632.4" height="22.5" as="geometry"/></mxCell><mxCell id="c502" value="&amp;#x27;La planta se detuvo: loop() no regresó en 2 s&amp;#x27;. La banda se para" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="575.5" width="604.5" height="22.5" as="geometry"/></mxCell><mxCell id="c503" value="y la ingeniera aparece. Error de compilación: subrayado rojo en la" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="597.5" width="613.8" height="22.5" as="geometry"/></mxCell><mxCell id="c504" value="línea + mensaje en la pestaña Consola; no se puede ejecutar." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="619.5" width="558.0" height="22.5" as="geometry"/></mxCell><mxCell id="c505" value="Confirmación en 3 niveles" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=17;fontColor=#D6336C;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="647.3" width="263.5" height="25.5" as="geometry"/></mxCell><mxCell id="c506" value="Menor: LED y traza cambian · Importante: objetivo ✓ + sonido ·" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="675.5" width="576.6" height="22.5" a