y="273.5" width="595.2" height="22.5" as="geometry"/></mxCell><mxCell id="c591" value="Se navega con flechas + Enter o con el mouse; el foco empieza en" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="297.5" width="595.2" height="22.5" as="geometry"/></mxCell><mxCell id="c592" value="&amp;#x27;Continuar&amp;#x27;." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="319.5" width="111.6" height="22.5" as="geometry"/></mxCell><mxCell id="c593" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6336C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2200" y="340" width="24" height="24" as="geometry"/></mxCell><mxCell id="c594" value="5" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=13;fontColor=#FFF;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2202.0" y="342.7" width="20.0" height="19.5" as="geometry"/></mxCell><mxCell id="c595" value="Estado del copiloto: punto verde &amp;#x27;en línea&amp;#x27; / gris &amp;#x27;sin conexión&amp;#x27;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="341.5" width="604.5" height="22.5" as="geometry"/></mxCell><mxCell id="c596" value="(el juego funciona sin internet; solo se pierde la explicación de la nube)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="365.5" width="697.5" height="22.5" as="geometry"/></mxCell><mxCell id="c597" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6336C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2200" y="386" width="24" height="24" as="geometry"/></mxCell><mxCell id="c598" value="6" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=13;fontColor=#FFF;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2202.0" y="388.7" width="20.0" height="19.5" as="geometry"/></mxCell><mxCell id="c599" value="Fondo: la misma escena de la fábrica (reutilizada), oscurecida 35%," style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="387.5" width="623.1" height="22.5" as="geometry"/></mxCell><mxCell id="c600" value="con el tablero &amp;#x27;3/3&amp;#x27; encendido." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="411.5" width="288.3" height="22.5" as="geometry"/></mxCell><mxCell id="c601" value="Qué NO muestra (decisión)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=17;fontColor=#D6336C;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="439.3" width="263.5" height="25.5" as="geometry"/></mxCell><mxCell id="c602" value="No hay &amp;#x27;Cuenta&amp;#x27; en el menú principal: está dentro de Opciones, porque" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="467.5" width="641.7" height="22.5" as="geometry"/></mxCell><mxCell id="c603" value="los niveles 1–2 se juegan sin cuenta (RI-06) y no queremos que crear" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="489.5" width="632.4" height="22.5" as="geometry"/></mxCell><mxCell id="c604" value="una cuenta parezca obligatorio." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="511.5" width="288.3" height="22.5" as="geometry"/></mxCell><mxCell id="c605" value="Legibilidad en 1366×768" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=17;fontColor=#D6336C;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="539.3" width="242.4" height="25.5" as="geometry"/></mxCell><mxCell id="c606" value="Botones 341×51 px y texto ~17 px: legible." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="567.5" width="390.6" height="22.5" as="geometry"/></mxCell><mxCell id="c607" value="Menú de pausa (≡ dentro del nivel)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=17;fontColor=#D6336C;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2200.0" y="595.3" width="358.4" height="25.5" as="geometry"/></mxCell><mxCell id="c608" value="Continuar · Reiniciar nivel (recupera la plantilla original) ·" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="623.5" width="576.6" height="22.5" as="geometry"/></mxCell><mxCell id="c609" value="Opciones · Salir al menú." style="text;html=1;align=le