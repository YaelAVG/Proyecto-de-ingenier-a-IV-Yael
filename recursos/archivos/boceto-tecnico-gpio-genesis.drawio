ue usa esa constante (aquí, línea 12)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="271.5" width="632.4" height="22.5" as="geometry"/></mxCell><mxCell id="c277" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6336C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2200" y="292" width="24" height="24" as="geometry"/></mxCell><mxCell id="c278" value="3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=13;fontColor=#FFF;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2202.0" y="294.7" width="20.0" height="19.5" as="geometry"/></mxCell><mxCell id="c279" value="LED de 16 px: verde HIGH · gris LOW · siempre dentro de su etiqueta." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="293.5" width="632.4" height="22.5" as="geometry"/></mxCell><mxCell id="c280" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D6336C;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2200" y="316" width="24" height="24" as="geometry"/></mxCell><mxCell id="c281" value="4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Inter;fontSize=13;fontColor=#FFF;fontStyle=1;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2202.0" y="318.7" width="20.0" height="19.5" as="geometry"/></mxCell><mxCell id="c282" value="Mini-trazas (de C2): 1 canal por pin del nivel, últimos 3 s." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=15;fontColor=#222;fontStyle=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="2234.0" y="317.5" width="558.0" height="22.5" as="geometry"/